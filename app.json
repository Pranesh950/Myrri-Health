{
  "expo": {
    "name": "Myrri",
    "slug": "health-app",
    "version": "1.0.0",
    "scheme": "myrri",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.myrri.myrri",
      "infoPlist": {
        "NSHealthShareUsageDescription": "We read your health data to show you personalized daily insights and trends.",
        "NSHealthUpdateUsageDescription": "We write health data when you manually log workouts or metrics.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.myrri.app",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_DISTANCE",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_RESTING_HEART_RATE",
        "android.permission.health.READ_HEART_RATE_VARIABILITY",
        "android.permission.health.READ_RESPIRATORY_RATE",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED",
        "android.permission.health.READ_HEIGHT",
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.READ_BLOOD_PRESSURE",
        "android.permission.health.READ_OXYGEN_SATURATION",
        "android.permission.health.READ_BODY_TEMPERATURE",
        "android.permission.health.READ_BODY_FAT",
        "android.permission.health.READ_LEAN_BODY_MASS",
        "android.permission.health.READ_VO2_MAX",
        "android.permission.health.READ_EXERCISE",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "compileSdkVersion": 36,
            "targetSdkVersion": 35,
            "buildToolsVersion": "36.0.0"
          }
        }
      ],
      "expo-router",
      "expo-font",
      "expo-splash-screen",
      "expo-health-connect",
      "./plugins/with-health-kit-ios.js",
      [
        "react-native-health",
        {
          "healthSharePermission": "We read your health data to show you personalized daily insights and trends.",
          "healthUpdatePermission": "We write health data when you manually log workouts or metrics."
        }
      ],
      "llama.rn",
      "./plugins/with-llama-pruned.js",
      "expo-sqlite",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Myrri to use the camera to scan food product barcodes."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "71049225-0edd-4b53-8cee-84c55f2d62b3"
      }
    },
    "owner": "shpranesh"
  }
}
